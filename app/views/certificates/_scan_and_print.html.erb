<div class="col-sm-12">
  <div class="row">  <!--row -->
    <div class="col-sm-2">
    </div>
    <div class="col-sm-10">
      <blockquote>
        <h5>Wydruki generowane w tym widoku ograniczone są tylko do pozycji <strong><%= @certificate.fullname %></strong>.</h5>
      </blockquote>
    </div> <!-- /.col-sm-12 -->
  </div> <!-- /.row -->

  <hr>

  <div class="row">  <!--dla Klienta -->
    <div class="col-sm-2">
      <p class="lead">dla Klienta</p>
    </div><!-- /.col-sm-2 -->
  
    <% if certificate_policy_check(@certificate, params[:category_service], 'print') %>
      <div class="col-sm-2">
        <div class="folded"><h3><%= @certificate.number %></h3></div>
        <%= link_to image_tag("certificate_#{params[:category_service]}.jpg", class: "img-thumbnail" ), 
              certificate_to_pdf_certificate_path(@certificate, category_service: @certificate.category.downcase, format: "pdf"), 
              target: "_blank" %>  

        <h5>Świadectwo</h5>
      </div><!-- /.col-sm-2 -->

      <%# Karta plastikowa – dodatkowy wydruk wg wzoru karty obowiązującego w dniu wydania świadectwa. %>
      <% card_template = CertificateCardTemplate.for_certificate(@certificate) %>
      <div class="col-sm-2">
        <div class="folded"><h3><%= @certificate.number %></h3></div>
        <% if card_template %>
          <%= link_to image_tag("certificate_card.png", class: "img-thumbnail" ),
                card_to_pdf_certificate_path(@certificate, category_service: @certificate.category.downcase, format: "pdf"),
                target: "_blank" %>
          <h5><%= t('pages.certificate_card_template.print.tile_one') %></h5>
          <p class="small"><%= card_template.name %></p>
        <% else %>
          <%= image_tag("certificate_card.png", class: "img-thumbnail", style: "opacity: .35;") %>
          <h5><%= t('pages.certificate_card_template.print.tile_one') %></h5>
          <p class="small text-muted"><%= t('pages.certificate_card_template.print.no_template', date: @certificate.date_of_issue) %></p>
        <% end %>
      </div><!-- /.col-sm-2 -->
    <% end %>

  </div class="row">  <!--/dla Klienta -->


</div> <!--/col-sm-12 -->
