<br>
<div class="panel-group" id="myaccordion">

  <!-- Dane -->
  <div class="row">
    <div class="col-sm-12">
      <div class="panel panel-certificate_card_template">
        <a class="accordion-toggle" data-toggle="collapse" data-parent="#myaccordion" href="#collapse_data">
          <div class="panel-heading">
            <div class="panel-title">
              <span class='<%= t("pages.certificate_card_template.model_icon") %>'>&nbsp;</span>
              <span><%=t "pages.certificate_card_template.show.title" %>:&nbsp;<%= @certificate_card_template.fullname %></span>
              <i class="indicator glyphicon glyphicon-chevron-down  pull-right"></i>
            </div>
          </div>
        </a>
        <div id="collapse_data" class="panel-collapse collapse in">
          <div class="panel-body">
            <div class="col-sm-11 col-sm-offset-1">
              <%= render 'form_show' %>
            </div>
          </div> <!-- /panel-body -->
        </div> <!-- /id="collapse_data" -->
      </div> <!-- /panel -->
    </div> <!-- /col-sm-12-->
  </div> <!-- /row -->

  <% if policy(:certificate_card_template).work? %>
    <%= render partial: "works/works_in_panel", locals: {trackable_type: 'CertificateCardTemplate', trackable_id: @certificate_card_template.id} %>
  <% end %>

</div> <!-- /class="panel-group" id="myaccordion" -->
