<div class="col-sm-12">
  <div class="row">
    <h3 class="center">
      <span class='<%= t("pages.division.model_icon") %> glyp-index-title' aria-hidden="true"></span>
      <span class="index-title"><%= t "pages.division.index.title" %></span>
    </h3>
  </div> <!--/row -->
</div> <!--/col-sm-12 -->

<div class="col-sm-12">
  <table id="divisions" class="hover cell-border" width="100%"
    data-source="<%= datatables_index_divisions_path(format: :json) %>">
    <thead>
      <tr>
        <th> 0 ID </th>
        <th><%= Division.human_attribute_name(:category) %></th>
        <th><%= Division.human_attribute_name(:short_name) %></th>
        <th><%= Division.human_attribute_name(:number_prefix) %></th>
        <th><%= Division.human_attribute_name(:name) %></th>
        <th><%= t "pages.division.index.columns.min_years_old" %></th>
        <th><%= t "pages.division.index.columns.face_image_required" %></th>
        <th><%= t "pages.division.index.columns.for_new_certificate" %></th>
        <th><%= t "pages.division.index.columns.proposal_via_internet" %></th>
        <th><%= t "pages.division.index.columns.enabled_in_confirmation" %></th>
        <th><%= t "pages.division.index.columns.card_template" %></th>
        <th>Akcje</th>
      </tr>
    </thead>
    <tbody>
       <!--data from JSON -->
    </tbody>
  </table>
</div> <!--/col-sm-12 -->

<div class="col-sm-12">
  <% if policy(:division).new? %>
    <%= link_to new_division_path, class: "btn btn-primary" do %>
      <span class="fa fa-plus"></span>
      <%= t("helpers.links.new") %>
    <% end %>
  <% end %>
</div> <!--/col-sm-12 -->
